# Environment variables the API reads (export them; there is no .env loader). Everything works locally without any.

# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/flu   # default: SQLite at backend/flu.db
# WEB_ORIGIN=http://localhost:3000
# API_ORIGIN=http://127.0.0.1:8000
# FLU_DEV_MODE=1            # dev OTP shown on screen, simulator endpoints mounted
# PROVIDER_MODE=fake        # fake | live (live needs every provider credential below; /v1/dev is not mounted)

# Secrets: change all of these before any real deployment.
# JWT_SECRET=
# TOKEN_ENC_KEY=            # base64 of 32 random bytes (AES-256-GCM for platform tokens)
# PAN_PEPPER=

# AI. With no key the app uses Flu's deterministic rules engine for every AI feature.
# ANTHROPIC_API_KEY=
# FLU_AI_MODE=auto          # auto | live | heuristic
# FLU_MODEL_MAIN=claude-sonnet-5-5
# FLU_MODEL_FAST=claude-haiku-5-5

# Real Instagram (Business Login for Instagram). Works for accounts added to your Meta app without App Review;
# everything else stays simulated and seeded demo creators keep their simulated accounts. See README "Connect a real
# Instagram account".
# INSTAGRAM_MODE=live
# INSTAGRAM_CLIENT_ID=      # "Instagram app ID" (not the Facebook app ID)
# INSTAGRAM_CLIENT_SECRET=  # "Instagram app secret"
# INSTAGRAM_REDIRECT_URI=   # only if the dashboard rejects the default http://127.0.0.1:8000/v1/connections/instagram/callback,
#                           # e.g. https://<your-tunnel>.trycloudflare.com/v1/connections/instagram/callback
# INSTAGRAM_GRAPH_VERSION=v25.0

# Other live providers (after Google OAuth verification)
# YOUTUBE_MODE=live
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_API_KEY=

# Razorpay (Orders + Route escrow). Use rzp_test_ keys first; webhook URL: {API_ORIGIN}/webhooks/razorpay with
# payment.captured, payment.failed, transfer.processed, transfer.failed and settlement.processed enabled.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_ESCROW_MAX_SLICES=20          # a hire's escrow is split so it can be released as the creator earns
# RAZORPAY_ESCROW_MIN_SLICE_PAISE=10000  # ₹100
# RAZORPAY_ROUTE_CATEGORY=media_and_entertainment   # creators' linked-account business profile; confirm with Razorpay
# RAZORPAY_ROUTE_SUBCATEGORY=content_and_publishing

# Cashfree Verification Suite (PAN, bank account, UPI). Sandbox: https://sandbox.cashfree.com/verification
# CASHFREE_BASE_URL=https://api.cashfree.com/verification
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_PUBLIC_KEY=      # PEM text or path; only when 2FA is "public key" instead of IP whitelisting

# MSG91 OTP (DLT-approved template)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=        # MSG91's OTP template id (sent with each OTP)
# MSG91_DLT_TE_ID=          # DLT template id and sender id are set on that template via Msg91Otp.register_dlt_template
# MSG91_SENDER_ID=
# MSG91_OTP_VERIFY=flu      # flu: Flu's hashed codes, MSG91 only delivers | msg91: MSG91 generates and verifies
# MSG91_BASE_URL=https://control.msg91.com
